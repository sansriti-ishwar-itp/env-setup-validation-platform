# Copy to .env — never commit secrets

# GitLab
GITLAB_PROJECT_ID=your-group%2Fyour-project
GITLAB_BRANCH=main
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-xxxxx

# Gemini / Google GenAI (set at least one; many tools read GOOGLE_API_KEY)
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: SQLite path for run state (default ./data/runs.db)
DATABASE_URL=sqlite:///./data/runs.db

# ADK REST (/adk) — POST /api/runs uses the built-in session + run_sse endpoints
# https://google.github.io/adk-docs/api-reference/rest/
ADK_SESSION_SERVICE_URI=
# Defaults to sqlite:///.../data/adk_sessions.db when unset
# ADK_MEMORY_SERVICE_URI=
# ADK_ARTIFACT_SERVICE_URI=
# ADK_ENABLE_A2A=false

# Optional: branch prefix for validation commits (commits go to GITLAB_BRANCH by default)
# Set to true to open MR instead of direct commit (future); unused in v1
# ENV_VALIDATION_CREATE_MR=false
